<?xml version="1.0" encoding="utf-8" ?>
<Config>
    <AmdQbProxy>
        <!-- OutputMode: pick either the number or the short name — both parse. -->
        <!-- 1 == "HalfSBS"    Half Side-by-Side (default modern pairing with a stereo panel) -->
        <!-- 2 == "FullSBS"    Full Side-by-Side (game renders at half display width) -->
        <!-- 3 == "HalfTAB"    Half Top-and-Bottom -->
        <!-- 4 == "FullTAB"    Full Top-and-Bottom -->
        <!-- 5 == "Anaglyph"   Red/Cyan Dubois -->
        <!-- 6 == "RowIL"      Row interleaved (passive 3D TVs) -->
        <!-- 7 == "ColumnIL"   Column interleaved -->
        <!-- 8 == "Checker"    Checkerboard (DLP-Link projectors) -->
        <!-- 9 == "SRWeave"           Simulated Reality Weave (Leia / Samsung Odyssey 3D) -->
        <!-- 11 == "3DVisionGlasses"  NVIDIA 3D Vision shutter output via NV3D-Lib. Requires 3D Vision -->
        <!--                          hardware (IR emitter + shutter glasses + 120Hz 3D Vision Ready panel) -->
        <!--                          AND a legacy NVIDIA driver (R417 or earlier) OR Oscar's Vision -->
        <!--                          Restoration patch for modern drivers. Falls back to Half SBS when -->
        <!--                          the runtime detects the hardware/driver chain is incomplete. -->
        <!-- 12 == "Katanga"          Produces a shared wide-SBS DX11 texture for bo3b's Katanga external -->
        <!--                          stereo viewer (standalone process). Launch Katanga separately before -->
        <!--                          starting the wrapped game; it picks up the shared handle automatically. -->
        <OutputMode Value="SRWeave"/>   <!-- or "1" / "9" / etc. -->

        <!-- SwapEyes: 0 = normal, 1 = swap left/right eye. Works with ALL output modes. -->
        <SwapEyes Value="0"/>

        <!-- AnaglyphColour: filter pair (only used when OutputMode=5).
             0 = Red / Cyan    (most common; widest filter availability)
             1 = Green / Magenta
             2 = Amber / Blue  (Trioscopic / ColorCode glasses) -->
        <AnaglyphColour Value="0"/>

        <!-- AnaglyphMethod: conversion algorithm (only used when OutputMode=5).
             0 = Dubois      (spectral least-squares fit; minimal ghosting with glasses)
             1 = Compromise  (Ahtik 2011; balanced for mixed audiences)
             2 = Color       (passthrough; max colour, max ghosting without glasses)
             3 = Half-Color  (one eye desaturated; reduced fringing)
             4 = Optimised   (Wimmer weighted-channel; less colour loss than Dubois)
             5 = Grey        (both eyes greyscale; near-zero ghosting)
             6 = True        (single-channel luma; historical, max ghosting) -->
        <AnaglyphMethod Value="0"/>
    </AmdQbProxy>
</Config>

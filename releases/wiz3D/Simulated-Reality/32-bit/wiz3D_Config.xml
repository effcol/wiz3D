<?xml version="1.0" encoding="utf-8"?>
<!-- wiz3D Simulated Reality config.
     Place next to dxgi.dll; the bootstrap reads it before deciding how to
     route stereo output.

     OutputMode: how the game's native stereo frames leave this proxy.
       "SRWeave"  - Hand frames to the LeiaSR SDK (via SimulatedRealityDirectX.dll)
                    for software weaving. Required for displays that don't
                    weave in hardware (Samsung Odyssey 3D style). Falls back
                    automatically to HalfSBS if the LeiaSR runtime isn't
                    installed on this machine. (Default.)
       "HalfSBS"  - Skip the SR SDK entirely. Drop a REDengine SBSDebug ini
                    so the game writes its own half-SBS to the backbuffer;
                    the connected display then handles the weave in hardware
                    (Acer SpatialLabs, Lume Pad, Lenovo ThinkVision 3D, Red
                    Magic). Also pairs with external weavers (SR-Loom,
                    Katanga).

     Dev override: setting the environment variable WIZ3D_SR_MODE=srweave or
     =sbsdebug wins over this file. "leiasr" is accepted as a legacy alias
     for "srweave" in both this file and the env var. -->
<Config Version="1">
    <OutputMode Value="SRWeave"/>
</Config>
